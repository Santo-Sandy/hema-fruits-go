# Server Configuration
# PORT=7002 # Render automatically sets PORT. Un-comment if you want to override locally.
ADMIN_SERVER_LISTEN_URL="0.0.0.0:7002"

# MongoDB Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME="hema_fruits"

# Security & Authentication
JWT_SECRET="your-super-secure-jwt-secret-key-change-this"

# CORS Configuration
# Comma-separated list of allowed origins. Set to "*" to allow all (credentials disabled).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-frontend.render.com"

# Cashfree Integration (Optional, falls back to mocks if empty)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox" # Use "sandbox" or "production"

# SMTP Email Configuration (Optional, falls back to console logs if empty)
CLIENT_EMAIL=""
CLIENT_EMAIL_PASSWORD=""

# Storage Configuration
S3_APIENDPOINT=""
